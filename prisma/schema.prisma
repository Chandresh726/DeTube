// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider            = "prisma-client"
  output              = "../app/generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  name          String?
  email         String         @unique
  image         String?
  password      String?
  balance       BigInt         @default(0)
  lockedBalance BigInt         @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  // Legacy denormalized pointer to the user's channel. Source of truth is
  // Channel.userId (@unique). Kept for backward compat with session/frontend;
  // do not write directly — use channelService.register.
  channelId     Int?           @unique
  channel       Channel? // A user can create only one channel
  subscriptions Subscription[] // Users can subscribe to multiple channels
  comments      Comment[] // Users can comment on videos
  reactions     Reaction[] // Users can react to videos (like or dislike)
  wallets       Wallet[]
  transactions  Transaction[]
}

model Channel {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(80)
  image         String?
  description   String?
  userId        Int            @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  videos        Video[] // A channel can have multiple videos
  subscriptions Subscription[] // A channel can have multiple subscriptions
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  transactions  Transaction[]

  @@index([updatedAt])
}

model Video {
  id           String     @id
  title        String     @db.VarChar(160)
  description  String?
  thumbnailUrl String
  videoUrl     String
  views        Int        @default(0)
  channelId    Int
  channel      Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  comments     Comment[] // A video can have multiple comments
  reactions    Reaction[] // A video can have multiple reactions (likes or dislikes)

  @@index([channelId])
  @@index([createdAt])
  @@index([channelId, createdAt])
  @@index([updatedAt])
}

model Subscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  channelId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, channelId])
  @@index([channelId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  videoId   String
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
  @@index([userId])
}

model Reaction {
  id        Int          @id @default(autoincrement())
  videoId   String
  userId    Int
  type      ReactionType
  createdAt DateTime     @default(now())
  video     Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId]) // Ensures one reaction per user per video
  @@index([videoId, type])
  @@index([userId, type, createdAt])
}

enum ReactionType {
  LIKE
  DISLIKE
}

model Wallet {
  id           Int           @id @default(autoincrement())
  address      String        @unique // Wallet address
  userId       Int
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id             Int               @id @default(autoincrement())
  userId         Int
  channelId      Int?
  walletId       Int? // The wallet that initiated the transaction
  amount         BigInt
  type           TransactionType
  status         TransactionStatus @default(PENDING)
  signature      String?           @unique // Blockchain transaction signature (unique => deposit idempotency)
  idempotencyKey String?           @unique // Client-supplied key for safe withdraw/thanks retries
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  channel        Channel?          @relation(fields: [channelId], references: [id], onDelete: SetNull)
  wallet         Wallet?           @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([channelId, type, status])
  @@index([userId, type, status, createdAt])
  @@index([walletId])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  THANKS
}

enum TransactionStatus {
  SUCCESS
  FAILED
  PENDING
}
